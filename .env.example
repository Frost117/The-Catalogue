# Umbraco Compose connection (show data). Copy this file to `.env` and set real
# values. The frontend talks to the same-origin /api/graphql route, which
# exchanges these client credentials for a short-lived access token
# (client-credentials grant) and forwards queries to the Compose GraphQL
# endpoint server-side.

# OAuth client credentials (Compose -> ClientId / ClientSecret). Server-only.
COMPOSE_CLIENT_ID=your-compose-client-id
COMPOSE_CLIENT_SECRET=your-compose-client-secret

# Token endpoint for the client-credentials grant (Compose -> AuthTokenUrl).
COMPOSE_AUTH_TOKEN_URL=https://management.umbracocompose.com/v1/auth/token

# OAuth scopes. Leave empty: the no-scope token authorizes querying AND
# introspection on the Compose GraphQL endpoint. `graphql` (querying) and
# `graphql:introspection` (codegen) only need setting if the endpoint starts
# rejecting the no-scope token, and they must first be granted to the API
# application in the portal (Access Control) — otherwise the token endpoint
# returns `invalid_scope`.
COMPOSE_SCOPE=

# Compose collection alias (Compose -> CollectionAlias), scoping queries to this collection.
COMPOSE_COLLECTION_ALIAS=your-collection-alias

# Full Compose GraphQL URL, pattern: /{project}/{environment}  (no /v1 prefix)
GQL_HOST=https://graphql.<region>.umbracocompose.com/<project>/<environment>

# Absolute site URL, used for i18n hreflang/canonical SEO tags.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Umbraco member-login backend. All /api/auth/* requests are proxied here
# (server/api/auth/[...].ts); it owns the phone-OTP login and issues the
# HttpOnly session cookie. In local dev, point it at the backend dev server
# (e.g. https://localhost:44386) with a trusted cert (mkcert) so the proxy can
# reach it over HTTPS.
MEMBER_LOGIN_HOST=https://localhost:44386

# Name of the member session cookie the backend sets on login. The comments
# proxy (server/api/comments.post.ts) rejects posts that arrive without it.
# Defaults to ASP.NET Core Identity's application-scheme cookie, which Umbraco
# members use and this backend doesn't rename. Override only if the backend
# customizes Cookie.Name for IdentityConstants.ApplicationScheme.
MEMBER_SESSION_COOKIE=.AspNetCore.Identity.Application
